---
---
<section class="relative overflow-hidden border-b border-border">
  <!-- Background: dark gradient + subtle network grid -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-br from-bg via-bg to-[#101410]"></div>
    <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M 48 0 L 0 0 0 48" fill="none" stroke="#C5F82A" stroke-width="0.5" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>
    <div class="absolute top-0 right-0 w-[60%] h-[80%] bg-lime/10 blur-[200px] rounded-full"></div>
    <div class="absolute bottom-0 left-0 w-[40%] h-[60%] bg-lime/5 blur-[160px] rounded-full"></div>
  </div>

  <div class="container-px max-w-7xl mx-auto py-24 md:py-36">
    <p class="label mb-6">// Preston East Solutions</p>

    <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl leading-[1.05] tracking-tight max-w-5xl">
      Enterprise-grade IT —<br />
      without the <span class="italic text-lime">enterprise headcount</span>.
    </h1>

    <p class="mt-8 max-w-2xl text-lg md:text-xl text-fg/80 leading-relaxed">
      15 years inside the engine rooms of Fortune 500s, federal contractors, and
      high-growth SaaS — now delivered to small businesses that need real
      technical horsepower without hiring a CTO.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/health-check" class="btn-primary">
        Book My Free IT Health Check
        <span aria-hidden="true">→</span>
      </a>
      <a href="#services" class="btn-secondary">
        See What We Do
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-16 flex items-center gap-6 text-xs text-muted">
      <span class="label">// Trusted across</span>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-fg/70">
        <span>Federal</span><span class="text-border">/</span>
        <span>SaaS</span><span class="text-border">/</span>
        <span>Healthcare</span><span class="text-border">/</span>
        <span>Finance</span><span class="text-border">/</span>
        <span>E-Commerce</span>
      </div>
    </div>
  </div>
</section>
