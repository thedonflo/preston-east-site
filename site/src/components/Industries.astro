---
const industries = [
  'Federal Government (Subcontract)',
  'SaaS — Startup & Post-IPO',
  'Healthcare',
  'Finance',
  'E-Commerce',
  'Tech',
];
---
<section class="border-b border-border">
  <div class="container-px max-w-7xl mx-auto py-20 md:py-28">
    <div class="flex flex-col gap-4 max-w-3xl mb-12">
      <p class="label">// Industries served</p>
      <h2 class="font-serif text-3xl md:text-5xl leading-tight">
        Experience across industries — <span class="italic text-lime">applied to small business problems.</span>
      </h2>
    </div>

    <ul class="flex flex-wrap gap-3">
      {industries.map((i) => (
        <li class="rounded-full border border-border bg-card/60 px-4 py-2 text-sm text-fg/85 hover:border-lime/60 hover:text-lime transition">
          {i}
        </li>
      ))}
    </ul>

    <p class="text-muted text-sm mt-8 max-w-3xl">
      Currently accepting new SMB clients in all sectors. Federal work limited
      to subcontract engagements.
    </p>
  </div>
</section>
