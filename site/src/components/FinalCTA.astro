---
<section class="relative border-b border-border overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-br from-bg via-bg to-[#0F140E]"></div>
    <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-final" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M 48 0 L 0 0 0 48" fill="none" stroke="#C5F82A" stroke-width="0.5" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-final)" />
      </svg>
    </div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[70%] h-[60%] bg-lime/10 blur-[200px] rounded-full"></div>
  </div>

  <div class="container-px max-w-5xl mx-auto py-24 md:py-32 text-center flex flex-col items-center gap-6">
    <p class="label">// One last thing</p>
    <h2 class="font-serif text-5xl md:text-7xl leading-tight">
      Ready to stop <span class="italic text-lime">hoping</span> your IT works?
    </h2>
    <p class="text-fg/80 text-lg md:text-xl leading-relaxed max-w-2xl">
      30 minutes. A 1-page report. Real next steps. Whether you hire us or not.
    </p>
    <div class="mt-4">
      <a href="/health-check" class="btn-primary text-base">
        Book My Free IT Health Check
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="text-sm text-muted mt-2">
      Or call directly:
      <a href="tel:+14432183731" class="hover:text-lime">(443) 218-3731</a>
      ·
      <a href="mailto:info@prestoneastsolutions.com" class="hover:text-lime">info@prestoneastsolutions.com</a>
    </p>
  </div>
</section>
