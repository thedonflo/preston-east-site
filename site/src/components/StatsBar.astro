---
const stats = [
  { value: '15+', unit: 'Years', detail: 'Enterprise IT experience' },
  { value: '6', unit: 'Services', detail: 'One partner, one bill' },
  { value: '6', unit: 'Industries', detail: 'From federal to e-commerce' },
  { value: 'Monthly', unit: 'Terms', detail: 'No annual lock-in' },
];
---
<section class="border-b border-border bg-card/40">
  <div class="container-px max-w-7xl mx-auto py-12 md:py-16 grid grid-cols-2 md:grid-cols-4 gap-y-10 gap-x-8">
    {stats.map((s) => (
      <div class="flex flex-col gap-2">
        <div class="flex items-baseline gap-2">
          <span class="font-serif italic text-5xl md:text-6xl text-lime leading-none">{s.value}</span>
          <span class="font-sans text-sm uppercase tracking-label text-fg/80">{s.unit}</span>
        </div>
        <p class="text-sm text-muted">{s.detail}</p>
      </div>
    ))}
  </div>
</section>
