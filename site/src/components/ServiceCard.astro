---
interface Props {
  number: string;
  category: string;
  name: string;
  emphasis?: string;
  tagline: string;
  description: string;
  href: string;
  icon: 'cloud' | 'code' | 'check' | 'shield' | 'lock' | 'compass';
}
const { number, category, name, emphasis, tagline, description, href, icon } = Astro.props;

const iconPaths = {
  cloud: '<path d="M7 18a4 4 0 0 1 .4-7.98A6 6 0 0 1 19 11a4 4 0 0 1 0 7H7z" />',
  code: '<polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />',
  check: '<polyline points="20 6 9 17 4 12" /><circle cx="12" cy="12" r="10" fill="none" />',
  shield: '<path d="M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z" />',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />',
  compass: '<circle cx="12" cy="12" r="10" /><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />',
};
---
<article class="group relative bg-card border border-border rounded-2xl p-8 flex flex-col gap-6 hover:border-lime/60 transition">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-4">
      <span class="font-serif italic text-5xl text-lime leading-none">{number}</span>
      <span class="label">// {category}</span>
    </div>
    <span class="text-lime opacity-60 group-hover:opacity-100 transition">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[icon]} />
    </span>
  </div>

  <h3 class="font-serif text-3xl md:text-4xl leading-tight">
    {emphasis ? (
      <>
        {name.replace(emphasis, '')}<span class="italic text-lime">{emphasis}</span>
      </>
    ) : name}
  </h3>

  <p class="label">{tagline}</p>

  <p class="text-fg/80 text-base leading-relaxed flex-1">{description}</p>

  <a href={href} class="inline-flex items-center gap-2 text-sm uppercase tracking-label text-fg group-hover:text-lime transition">
    Learn More
    <span aria-hidden="true" class="group-hover:translate-x-1 transition">→</span>
  </a>
</article>
