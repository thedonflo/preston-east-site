<section class="border-b border-border bg-card/30">
  <div class="container-px max-w-7xl mx-auto py-24 md:py-32 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
    <div class="lg:col-span-5 flex flex-col gap-6">
      <p class="label">// About</p>
      <h2 class="font-serif text-4xl md:text-5xl leading-tight">
        Built by an <span class="italic text-lime">operator</span>, not a salesperson.
      </h2>
      <blockquote class="mt-6 border-l-2 border-lime pl-6">
        <p class="font-serif italic text-xl md:text-2xl text-fg/90 leading-snug">
