---
interface Props {
  label: string;
  title: string;
  emphasis?: string;
  subtitle?: string;
}
const { label, title, emphasis, subtitle } = Astro.props;
---
<section class="relative overflow-hidden border-b border-border">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-br from-bg via-bg to-[#101410]"></div>
    <div class="absolute top-0 right-0 w-[50%] h-[80%] bg-lime/10 blur-[180px] rounded-full"></div>
  </div>
  <div class="container-px max-w-7xl mx-auto py-20 md:py-28">
    <p class="label mb-5">// {label}</p>
    <h1 class="font-serif text-5xl md:text-7xl leading-[1.05] tracking-tight max-w-5xl">
      {emphasis ? (
        <>
          {title.replace(emphasis, '')}<span class="italic text-lime">{emphasis}</span>
        </>
      ) : title}
    </h1>
    {subtitle && (
      <p class="mt-6 max-w-2xl text-lg md:text-xl text-fg/80 leading-relaxed">{subtitle}</p>
    )}
  </div>
</section>
