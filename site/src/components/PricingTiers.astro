---
import PricingCard from './PricingCard.astro';

const tiers = [
  {
    label: 'Foundation',
    name: 'Foundation',
    price: '$1,497',
    setup: '$1,500',
    best: 'Best for: 1–10 employees, basic IT under control.',
    includes: [
      'Cloud cost audit + monthly tracking',
      'Managed IT (helpdesk, monitoring)',
      'Backup & disaster recovery verification',
      'Security baseline audit',
      'Email support (business hours)',
      'Monthly status report',
      '1 strategy call per quarter',
    ],
    cta: 'Start with Foundation',
    href: '/contact?plan=foundation',
    highlight: false,
  },
  {
    label: 'Growth',
    name: 'Growth',
    emphasis: 'Growth',
    price: '$2,997',
    setup: '$2,500',
    best: 'Best for: 10–25 employees, scaling fast and IT is the bottleneck.',
    includes: [
      '<strong class="text-lime">Everything in Foundation</strong>',
      'Cloud optimization (ongoing, not one-time)',
      'App support &amp; light dev (up to 10 hrs/mo)',
      'QA &amp; testing support',
      'Endpoint security (full deployment)',
      'Compliance gap analysis (HIPAA / SOC 2 basics)',
      'Priority support (extended hours)',
      'Quarterly strategy session',
    ],
    cta: 'Deploy Growth',
    href: '/contact?plan=growth',
    highlight: true,
  },
  {
    label: 'Command',
    name: 'Command',
    price: '$4,997',
    setup: '$4,000',
    best: 'Best for: 25–50 employees, all-in IT partnership.',
    includes: [
      '<strong class="text-lime">Everything in Growth</strong>',
      'Fractional CTO sessions (monthly)',
      'App development (up to 25 hrs/mo)',
      'Full QA &amp; test automation suite',
      'SOC 2 / HIPAA readiness program',
      '24/7 priority support',
      'Dedicated communication channel',
      'Active vendor management',
    ],
    cta: 'Go Command',
    href: '/contact?plan=command',
    highlight: false,
  },
];
---
<section id="pricing" class="border-b border-border">
  <div class="container-px max-w-7xl mx-auto py-24 md:py-32">
    <div class="flex flex-col gap-4 max-w-3xl mb-16">
      <p class="label">// Pricing</p>
      <h2 class="font-serif text-4xl md:text-6xl leading-tight">
        Straightforward pricing. <span class="italic text-lime">No “call us for a quote” games.</span>
      </h2>
      <p class="text-fg/80 text-lg leading-relaxed">
        Month-to-month. Cancel anytime. Custom scopes available for anything
        that doesn’t fit the box.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      {tiers.map((t) => <PricingCard {...t} />)}
    </div>

    <article class="rounded-2xl border border-dashed border-border bg-card/40 p-8 flex flex-col md:flex-row md:items-center gap-6 md:gap-10">
      <div class="flex-1">
        <p class="label">// Custom</p>
        <h3 class="font-serif text-3xl mt-2">Let’s <span class="italic text-lime">talk.</span></h3>
        <p class="text-fg/70 mt-3 leading-relaxed">
          One-off projects, federal subcontract work, or anything between tiers
          — project-based or hybrid retainer/project. Public Trust cleared.
        </p>
      </div>
      <a href="/contact?plan=custom" class="btn-secondary shrink-0">
        Book a Discovery Call
        <span aria-hidden="true">→</span>
      </a>
    </article>

    <p class="text-muted text-sm mt-10 max-w-3xl leading-relaxed">
      All plans include free monthly business reviews, written documentation of
      everything we build, and a no-fault exit clause: 14 days’ notice to cancel
      any future cycle.
    </p>
  </div>
</section>
