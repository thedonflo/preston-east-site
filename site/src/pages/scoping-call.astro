---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import GHLCalendar from '../components/GHLCalendar.astro';
import FinalCTA from '../components/FinalCTA.astro';

const prep = [
  {
    title: 'Bring your Health Check report',
    detail: 'The 1-page scorecard from your free diagnostic. We build the roadmap directly off the red and amber findings.',
  },
  {
    title: 'Bring a rough budget envelope',
    detail: 'Even "ballpark only" helps. We can match the work to a tier (Foundation / Growth / Command) or scope a one-off project.',
  },
  {
    title: 'Bring the decision-makers',
    detail: 'If anyone else has veto power on tech spend, loop them in. Saves a second call.',
  },
];

const outputs = [
  '90-day roadmap with start dates and dependencies',
  'Recommended tier or scoped project quote',
  'Identified quick wins for the first 30 days',
  'Honest "we shouldn’t do this yet" callouts',
  'Written follow-up within 48 hours',
];
---
<Layout
  title="IT Roadmap Scoping Call — Preston East Solutions"
  description="45-minute scoping call to convert your Free IT Health Check into a costed, dated roadmap. By invitation after the Health Check report is delivered."
  showChatWidget={false}
>
  <PageHeader
    label="Scoping Call"
    title="From diagnostic to costed roadmap."
    emphasis="costed roadmap."
    subtitle="A 45-minute working session after your Free IT Health Check. We turn the red/amber findings into a 90-day plan with start dates, owners, and a clear tier or project quote."
  />

  <section class="border-b border-border">
    <div class="container-px max-w-7xl mx-auto py-20 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-5 flex flex-col gap-8">
        <div class="flex flex-col gap-5">
          <p class="label">// What you walk out with</p>
          <h2 class="font-serif text-3xl md:text-4xl leading-tight">
            A real plan — <span class="italic text-lime">not another sales call.</span>
          </h2>
          <ul class="grid grid-cols-1 gap-3 mt-2">
            {outputs.map((o) => (
              <li class="flex gap-3 items-start">
                <span class="shrink-0 mt-1 text-lime" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
                <p class="text-fg/90 leading-snug">{o}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col gap-5 pt-2">
          <p class="label">// Before the call</p>
          <ul class="grid grid-cols-1 gap-5">
            {prep.map((p) => (
              <li class="flex gap-4">
                <span class="shrink-0 mt-1 text-lime font-serif italic text-lg leading-none" aria-hidden="true">
                  →
                </span>
                <div>
                  <p class="text-fg font-medium leading-snug">{p.title}</p>
                  <p class="text-muted text-sm leading-relaxed mt-1">{p.detail}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <p class="text-xs text-muted mt-2 leading-relaxed">
          Haven&rsquo;t done your Free IT Health Check yet? Start there &mdash;
          <a href="/health-check" class="text-lime hover:underline">book a 30-minute diagnostic</a>
          and we&rsquo;ll send the scoping link after the report lands.
        </p>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="rounded-2xl border border-border bg-card/60 p-6 md:p-8 flex flex-col gap-4">
          <p class="label">// Pick a 45-minute slot</p>
          <GHLCalendar calendarId="Cq44DmNGMUWgpf9KbGWB" height={760} />
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</Layout>
