---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Layout
  title="Contact — Preston East Solutions"
  description="Reach Preston East Solutions for IT support, fractional CTO advisory, federal subcontract work, or to book a free IT Health Check."
  showChatWidget={false}
>
  <PageHeader
    label="Contact"
    title="Let’s talk."
    emphasis="talk."
    subtitle="Send a message, call directly, or book the free IT Health Check. We answer every inquiry within one business day."
  />

  <section class="border-b border-border">
    <div class="container-px max-w-7xl mx-auto py-20 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-7">
        <ContactForm
          title="Send us a message"
          fields={['name', 'email', 'phone', 'company', 'message']}
          submitLabel="Send message"
          formId="contact-page-form"
        />
      </div>

      <aside class="lg:col-span-5 flex flex-col gap-8">
        <div class="rounded-2xl border border-border bg-card p-6 md:p-8 flex flex-col gap-4">
          <p class="label">// Direct line</p>
          <div class="flex flex-col gap-2 text-fg/85">
            <a href="mailto:info@prestoneastsolutions.com" class="font-serif text-2xl text-fg hover:text-lime transition">
              info@prestoneastsolutions.com
            </a>
            <a href="tel:+14432183731" class="font-serif text-2xl text-fg hover:text-lime transition">
              (443) 218-3731
            </a>
          </div>
          <p class="text-sm text-muted leading-relaxed">
            Mon–Fri, 9a–6p ET. After-hours messages handled the next business
            morning. Active engagements get extended/24-7 support per tier.
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 md:p-8 flex flex-col gap-4">
          <p class="label">// Address</p>
          <p class="text-fg/85 leading-relaxed">
            Preston East Solutions LLC<br />
            1125 West St, Ste 200 #335<br />
            Annapolis, MD 21401
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 md:p-8 flex flex-col gap-4">
          <p class="label">// Free IT Health Check</p>
          <p class="text-fg/85 leading-relaxed">
            30 minutes, zero pitch. The fastest way to see what we’d
            actually do for your IT — and you keep the 1-page report.
          </p>
          <a href="/health-check" class="btn-primary text-sm w-fit">
            Book my Health Check
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-b border-border bg-card/30">
    <div class="container-px max-w-7xl mx-auto py-12">
      <p class="label mb-4">// On the map</p>
      <div class="rounded-2xl overflow-hidden border border-border bg-bg">
        <iframe
          title="Preston East Solutions office location — Annapolis, MD"
          src="https://www.google.com/maps?q=1125+West+St,+Annapolis,+MD+21401&output=embed"
          width="100%"
          height="380"
          style="border:0; filter: invert(0.9) hue-rotate(180deg);"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
